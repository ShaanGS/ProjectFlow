# Copy to .env.local for local development.
# In Vercel, add these in Project Settings -> Environment Variables.
# Never commit real secret values.

# Required for Groq-backed follow-up chat responses.
GROQ_API_KEY=

# Optional. Defaults to qwen/qwen3-32b when omitted.
GROQ_MODEL=qwen/qwen3-32b

# Optional Vectorize Hindsight settings. The current deployable demo uses the
# committed incident seed dataset unless this integration is wired explicitly.
HINDSIGHT_BASE_URL=https://hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_PIPELINE_ID=
