# Copy to .env.local and fill in values (never commit real secrets).

# Groq — optional in basic demo; required for LLM follow-ups when KAIRO_DEMO_MODE=llm
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Vectorize Hindsight — incident memory / recall
HINDSIGHT_BASE_URL=https://hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_PIPELINE_ID=

# Omit or leave empty for template/demo responses; set to "llm" for full chat when Groq is configured
KAIRO_DEMO_MODE=


